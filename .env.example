# Copy to .env (git-ignored) and fill in. Leave both blank to run on bundled sample data.
# Find them in Supabase: Project Settings > API. Use the *publishable* key only, never the secret/service key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Later, for a Google Places ingest (server-side only, do not expose to the browser):
# GOOGLE_PLACES_API_KEY=
